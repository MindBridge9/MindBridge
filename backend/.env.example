# Python 3.12. Process environment overrides backend/.env.
# Health makes no provider calls. Fallback is opt-in and bounded across providers.
AI_PROVIDER=groq
AI_ENABLED=true
# Reviewed readiness only, comma-separated; keys alone never activate health capabilities.
APPROVED_CAPABILITIES=
# Synthetic/nonpersonal integration only; rejected in production. Not acceptance evidence.
SYNTHETIC_DEVELOPMENT_INTEGRATION=false
# OFF until reviewed and verified; enabling requires both backend keys.
AI_FALLBACK_ENABLED=false
CLIENT_REQUESTS_PER_MINUTE=6
GLOBAL_REQUESTS_PER_MINUTE=12
GLOBAL_REQUESTS_PER_DAY=400
MAX_RATE_LIMIT_CLIENTS=2048
# Socket peers are used by default. Only list verified hosting proxy CIDRs.
TRUSTED_PROXY_CIDRS=
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CORS_ORIGINS=http://localhost:5173
# Swagger/OpenAPI are disabled by default. Use development locally to enable them.
MINDBRIDGE_ENV=production
# Do not put credentials in this template or frontend variables.
