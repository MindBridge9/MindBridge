# Python 3.12. Process environment overrides backend/.env.
# Health makes no provider calls. POST /api/read sends the image to Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CORS_ORIGINS=http://localhost:5173
# Swagger/OpenAPI are disabled by default. Use development locally to enable them.
MINDBRIDGE_ENV=production
# Do not put credentials in this template or frontend variables.
