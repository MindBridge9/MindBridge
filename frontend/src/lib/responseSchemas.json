          "max_answer_chars": {
            "const": 2000
          }
        },
        "required": [
          "max_image_bytes",
          "max_source_chars",
          "max_answer_chars"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "status",
      "service",
      "api_version",
      "capabilities",
      "reading_levels",
      "explanation_languages",
      "limits"
    ],
    "additionalProperties": false
  },
  "ReadingLevel": {
    "type": "string",
    "enum": [
      "original",
      "easy",
      "guided"
    ]
  },
