      },
      "api_version": {
        "const": "1.0"
      },
      "capabilities": {
        "type": "object",
        "properties": {
          "read": {
            "type": "boolean"
          },
          "simplify": {
            "type": "boolean"
          },
          "define": {
            "type": "boolean"
          },
          "explain": {
            "type": "boolean"
          },
          "prepare_understanding": {
            "type": "boolean"
          },
          "check_understanding": {
            "type": "boolean"
          }
        },
        "required": [
          "read",
          "simplify",
          "define",
          "explain",
          "prepare_understanding",
          "check_understanding"
